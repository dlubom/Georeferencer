#!/usr/bin/env python3
"""Dwa czyste checkouty jednego commitu, zimne wyniki, odbiór bez publikacji."""
import argparse
import json
import os
import re
import shutil
import subprocess
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--repo', type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument('--revision', required=True)
    parser.add_argument('--work-dir', type=Path, required=True, help='Nowy, nieistniejący katalog')
    parser.add_argument('--conserve-disk', action='store_true',
                        help='Po odbiorze a zachowaj jego wyniki i usuń checkout przed klonowaniem b')
    args = parser.parse_args()
    repo, work = args.repo.resolve(), args.work_dir.resolve()
    revision = subprocess.check_output(['git', '-C', str(repo), 'rev-parse', '--verify', args.revision + '^{commit}'], text=True).strip()
    if not re.fullmatch('[0-9a-f]{40}', revision):
        raise ValueError('Wymagany commit SHA-1')
    work.mkdir()  # nigdy nie wznawiaj starych wyników jako zimnego buildu
    env = {k: v for k, v in os.environ.items() if not k.startswith(('GITHUB_', 'GEOREFERENCER_'))}

    def run(command, directory, log):
        print(f'{log}: {command}', flush=True)
        with (work / log).open('w') as stream:
            subprocess.run(command, cwd=directory, env=env, stdout=stream, stderr=subprocess.STDOUT, check=True)

    checkouts = []
    evidence = {'revision': revision, 'checkouts': [], 'publication': False}
    for name in ('a', 'b'):
        checkout = work / name
        run(['git', 'clone', '--no-local', '--no-checkout', str(repo), str(checkout)], repo, name + '-clone.log')
        run(['git', 'checkout', '--detach', revision], checkout, name + '-checkout.log')
        if (checkout / 'build').exists():
            raise ValueError('Checkout zawiera stare wyniki')
        run(['./scripts/build', 'generate', '--all'], checkout, name + '-generate.log')
        current = (checkout / 'build/geotiff/current').resolve(strict=True)
        manifest = json.loads((current / 'manifest.json').read_text())
        if manifest['build']['reused'] or set(manifest['build']['generated']) != {p['dir_id'] for p in manifest['plans']}:
            raise ValueError('Nie był to pełny zimny build')
        if manifest['code'] != {'commit': revision, 'dirty': 'false'}:
            raise ValueError('Niepoprawne pochodzenie kodu')
        # Raz rozwiązany current, ta sama ścieżka dla wszystkich późniejszych kontroli.
        relative = current.relative_to(checkout / 'build')
        for mode in ('tag', 'manual'):
            run(['./scripts/build', 'package', '--mode', mode,
                 '--run-dir', '/build/' + str(relative), '--reports-dir', f'/build/{mode}-qa',
                 '--archive', f'/build/{mode}.zip'], checkout, f'{name}-{mode}.log')
        status = subprocess.check_output(['git', 'status', '--porcelain'], cwd=checkout, env=env, text=True)
        if status:
            raise ValueError('Build zmienił checkout: ' + status)
        item = {'name': name, 'clean_before': True, 'clean_after': True,
            'cold_result_cache': True, 'run': str(current.relative_to(work)),
            'git_common_dir': subprocess.check_output(['git', 'rev-parse', '--git-common-dir'], cwd=checkout, text=True).strip()}
        if args.conserve_disk and name == 'a':
            retained = work / 'a-results'
            shutil.move(str(checkout / 'build'), retained)
            item['run'] = str(Path('a-results') / relative)
            item['checkout_removed_after_acceptance'] = True
            shutil.rmtree(checkout)
        evidence['checkouts'].append(item)
        checkouts.append(checkout)
    image_file = work / 'runtime-image'
    run(['docker', 'build', '--platform', 'linux/amd64', '--iidfile', str(image_file), str(checkouts[1] / 'ci')], repo, 'runtime.log')
    run(['docker', 'run', '--rm', '--platform', 'linux/amd64', '--network', 'none', '--read-only',
         '--tmpfs', '/tmp:rw,nosuid,size=512m',
         '--mount', f'type=bind,source={checkouts[1]},target=/workspace,readonly',
         '--mount', f'type=bind,source={work},target=/audit', image_file.read_text().strip(),
         'python', 'pipeline/release_acceptance.py', '--report', '/audit/comparison.json', 'compare',
         '--left', '/audit/' + evidence['checkouts'][0]['run'],
         '--right', '/audit/' + evidence['checkouts'][1]['run']], repo, 'comparison.log')
    result = json.loads((work / 'comparison.json').read_text())
    evidence.update(passed=result['passed'], plans=result['plans'])
    (work / 'checkouts.json').write_text(json.dumps(evidence, indent=2) + '\n')
    print(f'Odbiór dwóch buildów OK: {result["plans"]} planów. Dowody: {work}', flush=True)


if __name__ == '__main__':
    main()
